 static struct sweet_bo sweet_bos[BO_MAX];
 static uint64_t sweet_bo_next = BO_VA_BASE;
 
+/* What the page table says about one address, the way space_map walks it. */
+static uint64_t
+sweet_bo_pte(struct gpu_space *space, uint64_t address)
+{
+	uint64_t *table = space->root;
+
+	for (int level = 0; level < 2; level++) {
+		uint64_t entry = table[(address >> (30 - 9 * level)) & 0x1ff];
+		uint64_t *next = NULL;
+
+		if (!(entry & 1)) {
+			return 0;
+		}
+		for (uint32_t i = 0; i < space->table_count; i++) {
+			if (space->tables[i].phys == (entry & PTE_ADDRESS)) {
+				next = space->tables[i].table;
+				break;
+			}
+		}
+		if (next == NULL) {
+			return entry;
+		}
+		table = next;
+	}
+	return table[(address >> 12) & 0x1ff];
+}
+
+/* Make the SMMU forget what it walked before: space_on() does the same when it switches a context on. */
+static void
+sweet_bo_flush(struct gpu_space *space)
+{
+	uint32_t context = smmu_context(space);
+
+	space_commit(space);
+	put(&smmu, "cb tlbiasid", context + SMMU_CB_TLBIASID, context);
+	put(&smmu, "cb tlbsync", context + SMMU_CB_TLBSYNC, 1);
+	wait_for(&smmu, context + SMMU_CB_TLBSTATUS, 1, 0, 100);
+}
+
