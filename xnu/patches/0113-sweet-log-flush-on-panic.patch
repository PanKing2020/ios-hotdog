+/*
+ * Debug aid for the staged bring-up: write the line and push the persistent log ring
+ * out at once (the panic path does the same), so the last thing that ran is readable
+ * from a recovery even when the kernel dies before the 10 s flush tick.
+ */
+static void
+sweet_gpu_trace(const char *fmt, ...)
+{
+	char line[192];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		printf("%s", line);
+	}
+	sweet_log_flush_now();
+}
