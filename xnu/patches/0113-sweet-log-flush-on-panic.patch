+static bool sweet_log_on;               /* the flush thread runs: the ring may be written now */
 
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
@@ -797,6 +794,61 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+
+/*
+ * Write the ring out now. The panic path calls this so that a panic that kills the
+ * machine before the next 10 s tick is still readable from a recovery (the panic text
+ * is in the ring; without this it stays in RAM and dies with it). Never blocks: if the
+ * flush thread holds the lock, the ring stays as it is.
+ */
+void sweet_log_flush_now(void);
+
+void
+sweet_log_flush_now(void)
+{
+	uint64_t base, total, pos;
+	void *bounce;
+	int error = 0;
+
+	if (!sweet_log_on || !su.ready || !su.writable) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		return;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	/* Only the newest window: one or two UFS writes from the panic path, not the whole 4 MiB. */
+	pos = total > 48u << 10 ? total - (48u << 10) : 0;
+	pos -= pos % UFS_BLOCK;
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos = (uint64_t)(blk + n) * UFS_BLOCK;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = 0,
+		};
+
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		(void)ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
