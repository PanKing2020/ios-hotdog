+/* ---- the buffer pool: mapped while the 3D core's context is still off --------------------------------- */
+
+#define BO_POOL_BYTES   (8u * 1024 * 1024)
+#define BO_VA_BASE      0x40000000ull
+
+static vm_offset_t bo_pool_memory;
+static uint32_t bo_pool_used;
+
+/*
+ * The SMMU reads the page tables from memory, and a translation it has already walked is kept. A
+ * mapping made while the context is off is flushed with all the others by space_on(); one made after
+ * that is not, which is why the buffer pool is reserved here instead of at the first client.
+ */
+static bool
+sweet_bo_pool_init(void)
+{
+	if (bo_pool_memory != 0) {
+		return true;
+	}
+	if (kmem_alloc(kernel_map, &bo_pool_memory, BO_POOL_BYTES, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEETADRENO: bo: cannot make the buffer pool\n");
+		return false;
+	}
+	for (uint32_t offset = 0; offset < BO_POOL_BYTES; offset += 4096) {
+		if (!space_map(&core_space, BO_VA_BASE + offset, kvtophys(bo_pool_memory + offset), PTE_CORE)) {
+			printf("SWEETADRENO: bo: cannot map the buffer pool\n");
+			return false;
+		}
+	}
+	bo_pool_used = 0;
+	printf("SWEETADRENO: bo: %u KiB of buffers at %#llx for the GPU, %#llx ours\n", BO_POOL_BYTES / 1024,
+	    BO_VA_BASE, kvtophys(bo_pool_memory));
+	return true;
+}
+
