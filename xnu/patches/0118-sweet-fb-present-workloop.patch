 void
+AppleCLCD::presentFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint8_t *rec = NULL;
+
+	if (fb->fScaling) {
+		IOLockLock(fb->fLock);
+		if (fb->fDirty) {
+			rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+			if (rec != NULL) {
+				memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+				fb->fDirty = false;
+			}
+		}
+		IOLockUnlock(fb->fLock);
+	}
+	if (rec != NULL) {
+		fb->present(rec);
+		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+		fb->fPresented++;
+		if ((fb->fPresented % 120) == 0) {
+			IOLog("SWEET FB: presented %llu frames\n", fb->fPresented);
+		}
+	}
+	if (fb->fPresentTimer != NULL) {
+		sender->setTimeoutUS(2000);
+	}
+}
