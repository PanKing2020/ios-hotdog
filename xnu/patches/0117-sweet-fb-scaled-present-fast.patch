@@ -118,6 +118,7 @@
 	uint32_t      fFadeStep;      /* fade-out steps done while off */
 	bool          fScaling;       /* present the logical frame scaled to the panel */
 	uint32_t     *fXMap, *fYMap;  /* panel pixel -> logical pixel */
+	uint32_t     *fRowBuf;        /* one logical row, so the source is read in order */
 
 	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
 	void addClient(IOMobileFramebufferUserClient *client);
@@ -209,6 +210,10 @@
 			for (uint32_t i = 0; i < fHeight; i++) {
 				fYMap[i] = (uint32_t)((uint64_t)i * fLogicalH / fHeight);
