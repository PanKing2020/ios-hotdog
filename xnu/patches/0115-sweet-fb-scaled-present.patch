@@ -181,8 +188,29 @@ AppleCLCD::start(IOService *provider)
 		fLogicalW = SWEET_FB_LOGICAL_W;
 		fLogicalH = SWEET_FB_LOGICAL_H;
 	}
+	if (want_w >= 320 && want_h >= 320) {
+		fLogicalW = want_w;
+		fLogicalH = want_h;
+	}
 	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
 	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+	/* sweetfb_scale=1: the userland keeps the logical size (e.g. iPhone X) and the panel gets
+	 * the frame scaled to its own size, so the screen is filled instead of letterboxed. */
+	fScaling = scaling != 0 && (fLogicalW != fWidth || fLogicalH != fHeight);
+	if (fScaling) {
+		fXMap = (uint32_t *)IOMalloc((size_t)fWidth * sizeof(uint32_t));
+		fYMap = (uint32_t *)IOMalloc((size_t)fHeight * sizeof(uint32_t));
+		if (fXMap == NULL || fYMap == NULL) {
+			fScaling = false;
+		} else {
+			for (uint32_t i = 0; i < fWidth; i++) {
+				fXMap[i] = (uint32_t)((uint64_t)i * fLogicalW / fWidth);
+			}
+			for (uint32_t i = 0; i < fHeight; i++) {
+				fYMap[i] = (uint32_t)((uint64_t)i * fLogicalH / fHeight);
+			}
+		}
+	}
 	fLock = IOLockAlloc();
 	fClients = OSArray::withCapacity(4);
 	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
@@ -360,6 +388,27 @@ AppleCLCD::present(const uint8_t *rec)
 			w = (int32_t)s->width;
 			h = (int32_t)s->height;
 		}
+		if (fScaling) {
+			/* The userland's frame (the logical display) becomes the panel's, scaled. Only the
+			 * frame that is the logical display is scaled; other layers are left alone. */
+			if (src != 0 && bpe == 4 && s->memory != NULL && s->bytesPerRow >= s->width * 4 &&
+			    s->width == fLogicalW && s->height == fLogicalH && fXMap != NULL && fYMap != NULL) {
+				uint32_t sw = s->width, sh = s->height, sbpr = s->bytesPerRow;
+
+				for (uint32_t y = 0; y < fHeight; y++) {
+					uint32_t ly = fYMap[y];
+					uint32_t *d = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+					const uint32_t *r = (const uint32_t *)(src + s->offset + (uint64_t)(ly < sh ? ly : sh - 1) * sbpr);
+
+					for (uint32_t x = 0; x < fWidth; x++) {
+						uint32_t lx = fXMap[x];
+						d[x] = r[lx < sw ? lx : sw - 1];
+					}
+				}
+			}
+			s->release();
+			continue;
+		}
 		if (sx < 0 || sy < 0) {
 			sx = sy = 0;
 		}
